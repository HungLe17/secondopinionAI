# Server secret. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Required outside Google Cloud (including Google AI Studio). Base64-encode
# the entire Firebase service-account JSON file and store it as a secret.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Server settings
GEMINI_MODEL=gemini-3.5-flash
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
APP_BASE_URL=http://localhost:3000
APP_ENV=development
